# Aegis-Gate Environment Variables Configuration
# Copy this file to .env and fill in the values before running the application.

# Security Keys
# Generate a secure 64-character hex string for the secret key.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_secret_key_here

# Admin Credentials
# The initial password for the 'admin' account.
ADMIN_PASSWORD=Admin@1234_Secure

# Flask Settings
# Set to true only in development environments. Must be false in production.
FLASK_DEBUG=false
